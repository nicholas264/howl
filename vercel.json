{
  "framework": "vite",
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/script-studio.js": {
      "maxDuration": 120
    },
    "api/dealer-analytics.js": {
      "maxDuration": 120
    },
    "api/drive/ugc.js": {
      "maxDuration": 300
    },
    "api/meta.js": {
      "maxDuration": 300
    },
    "api/creative-analysis-worker.js": {
      "maxDuration": 300
    },
    "api/render-ugc.js": {
      "maxDuration": 300
    },
    "api/ugc-edit-suggest.js": {
      "maxDuration": 60
    },
    "api/creative-sync-cron.js": {
      "maxDuration": 300
    },
    "api/render-recovery-cron.js": {
      "maxDuration": 300
    },
    "api/static-studio.js": {
      "maxDuration": 300
    },
    "api/finance.js": {
      "maxDuration": 300
    },
    "api/quickbooks-callback.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/creative-analysis-worker",
      "schedule": "0 12,16,20 * * *"
    },
    {
      "path": "/api/map-monitor-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/creative-sync-cron",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/render-recovery-cron",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/dealer-intake",
      "destination": "/dealer-intake.html"
    },
    {
      "source": "/legal/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/legal/privacy",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/apply",
      "destination": "/index.html"
    },
    {
      "source": "/submit",
      "destination": "/index.html"
    },
    {
      "source": "/agreement",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run check && npm audit --audit-level=high"
}
