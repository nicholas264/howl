{
  "framework": "vite",
  "functions": {
    "api/drive/ugc.js": {
      "maxDuration": 300
    },
    "api/meta.js": {
      "maxDuration": 300
    },
    "api/creative-analysis-worker.js": {
      "maxDuration": 300
    },
    "api/render-ugc.js": {
      "maxDuration": 300
    },
    "api/ugc-edit-suggest.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/creative-analysis-worker",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
