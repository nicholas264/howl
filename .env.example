# ────────────────────────────────────────────────────────────────────────
# Auth (Clerk)
# ────────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Canonical production URL used for invitation redirects.
APP_URL=https://your-production-domain.example
# Comma-separated emails permitted for admin-gated routes (schema migrations etc).
ADMIN_EMAILS=you@example.com,teammate@example.com
# Local-dev only: set to "true" to bypass auth. Never enable in production.
AUTH_DISABLED=false

# ────────────────────────────────────────────────────────────────────────
# Creator intake (ClickUp)
# ────────────────────────────────────────────────────────────────────────
CLICKUP_API_TOKEN=pk_...
CLICKUP_CREATOR_LIST_ID=123456789
CLICKUP_CREATOR_VIEW_ID=6-123456789-1

# ────────────────────────────────────────────────────────────────────────
# Database (Neon Postgres)
# ────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ────────────────────────────────────────────────────────────────────────
# AI providers
# ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Whisper transcription + UGC editor.
OPENAI_API_KEY=sk-...

# ────────────────────────────────────────────────────────────────────────
# Meta (Facebook + Instagram ads)
# ────────────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=system-user-long-lived-token
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=404789730317028
# Required when targeting Instagram placements (reels, story).
META_INSTAGRAM_USER_ID=17841401234567890
# Mirrored to the client bundle. VITE_ prefix exposes them to the browser —
# only set values you're OK shipping public.
VITE_META_AD_ACCOUNT_ID=act_1234567890
VITE_META_PAGE_ID=404789730317028
VITE_META_INSTAGRAM_USER_ID=17841401234567890

# ────────────────────────────────────────────────────────────────────────
# Google — Drive (UGC inbox via Workload Identity Federation)
# ────────────────────────────────────────────────────────────────────────
GCP_SERVICE_ACCOUNT_EMAIL=howl-drive@project.iam.gserviceaccount.com
GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/.../providers/...
GOOGLE_DRIVE_FOLDER_ID=1abc...
UGC_INBOX_FOLDER_ID=1abc...
# Optional legacy Google OAuth (only if not using WIF).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_REDIRECT_URI=
# Google Sheets (forecast pulls).
FORECAST_SHEET_ID=

# ────────────────────────────────────────────────────────────────────────
# Google Ads (campaign reporting)
# ────────────────────────────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ────────────────────────────────────────────────────────────────────────
# Shopify (storefront + dealer store)
# ────────────────────────────────────────────────────────────────────────
SHOPIFY_STORE=howl-campfires.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_DEALER_STORE=
SHOPIFY_DEALER_ACCESS_TOKEN=

# ────────────────────────────────────────────────────────────────────────
# Vercel Blob (UGC videos, callout images) — auto-set by the Blob integration.
# ────────────────────────────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=

# Optional one-off install gate for the Shopify install endpoint.
ADMIN_INSTALL_KEY=
